---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { categories, providerGroups, services } from "@/data/services";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import ProviderMarks from "@/components/ui/ProviderMarks.astro";
import DigitalLifeIllustration from "@/components/ui/DigitalLifeIllustration.astro";
---

<BaseLayout title={site.name} description={site.description}>
  <main id="main-content">
    <section class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
      <div>
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand-900">
          <span
            class="size-2 rounded-full bg-accent-500"
            aria-hidden="true"
          ></span>
          Digital services, made straightforward
        </p>
        <h1 class="max-w-2xl text-4xl font-semibold leading-tight tracking-tight text-brand-900 sm:text-5xl lg:text-6xl">
          Your trusted hub for{" "}
          <span class="text-brand-700">digital services.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
          {site.name} brings everyday digital service requests together with
          clear guidance and personal support.
        </p>
        <a
          class="mt-4 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-brand-800 hover:text-brand-700"
          href="/contact"
        >
          <span>{site.location}</span>
          <span aria-hidden="true">·</span>
          <span>{site.openingHours}</span>
        </a>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-800 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            href="/services"
          >
            Explore services
          </a>
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-800 transition-colors hover:border-brand-700 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            href="/contact"
          >
            Get in touch
          </a>
        </div>
        <p class="mt-5 max-w-lg text-sm leading-6 text-slate-500">
          Printing files and design references can be sent in WhatsApp after you
          start a service enquiry. The team confirms the price and next steps
          with you.
        </p>
      </div>

      <div class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="relative">
          <DigitalLifeIllustration />
          <p class="text-sm font-semibold text-brand-800">
            People-first digital help
          </p>
          <h2 class="mt-2 max-w-sm text-2xl font-semibold tracking-tight text-slate-950">
            From your screen to our service desk.
          </h2>
          <ol class="mt-8 space-y-6">
            <li class="flex gap-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-50 text-sm font-bold text-brand-800">
                1
              </span>
              <div>
                <h3 class="font-semibold text-slate-900">Choose a service</h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  Find the service that fits your request.
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-50 text-sm font-bold text-brand-800">
                2
              </span>
              <div>
                <h3 class="font-semibold text-slate-900">
                  Share the required details
                </h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  Our team will guide you through the next steps.
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-50 text-sm font-bold text-brand-800">
                3
              </span>
              <div>
                <h3 class="font-semibold text-slate-900">
                  Make a manual payment
                </h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  Payment is checked by an administrator before fulfilment.
                </p>
              </div>
            </li>
          </ol>
          <p class="mt-7 rounded-xl bg-slate-50 p-4 text-xs leading-5 text-slate-600">
            No payment gateway or automatic service fulfilment is used in this
            planned workflow.
          </p>
        </div>
      </div>
    </section>

    <section
      class="border-y border-slate-200 bg-white py-10 sm:py-12"
      aria-labelledby="providers-heading"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
              Familiar providers
            </p>
            <h2
              id="providers-heading"
              class="mt-2 text-xl font-semibold tracking-tight text-brand-900 sm:text-2xl"
            >
              One place for everyday digital errands
            </h2>
          </div>
          <a
            class="font-semibold text-brand-800 hover:text-brand-700"
            href="/services"
          >
            See supported services <span aria-hidden="true">→</span>
          </a>
        </div>
        <ProviderMarks groups={providerGroups} />
        <p class="mt-4 text-xs leading-5 text-slate-500">
          Provider marks are shown for service selection only; no affiliation is
          implied.
        </p>
      </div>
    </section>

    <section
      class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20"
      aria-labelledby="categories-heading"
    >
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
            Explore
          </p>
          <h2
            id="categories-heading"
            class="mt-2 text-2xl font-semibold tracking-tight text-brand-900 sm:text-3xl"
          >
            Services for everyday needs
          </h2>
        </div>
        <a
          class="font-semibold text-brand-800 hover:text-brand-700"
          href="/services"
        >
          View all services <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category) => (
          <a
            class="rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
            href={`/services?category=${category.slug}`}
          >
            <h3 class="font-semibold text-slate-900">{category.name}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              {category.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <section
      class="border-y border-slate-200 bg-white py-16 sm:py-20"
      aria-labelledby="featured-heading"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
          Popular services
        </p>
        <h2
          id="featured-heading"
          class="mt-2 text-2xl font-semibold tracking-tight text-brand-900 sm:text-3xl"
        >
          Pick a service and get started
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">
          Printing, registrations, exam services, graphic design, utility
          payments, coding and website design, AI-assisted content, project
          research, and more. Enquire on WhatsApp and we’ll confirm the details.
        </p>
        <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services
            .filter((service) =>
              [
                "document-printing",
                "online-registration",
                "graphic-design",
                "coding-website-design",
                "ai-content-creation",
                "project-research-support",
              ].includes(service.slug),
            )
            .map((service) => (
              <ServiceCard service={service} />
            ))}
        </div>
      </div>
    </section>

    <section
      id="how-it-works"
      class="border-y border-slate-200 bg-white"
      aria-labelledby="foundation-heading"
    >
      <div class="mx-auto grid max-w-7xl gap-3 px-5 py-8 sm:px-8 md:grid-cols-3">
        <h2
          id="foundation-heading"
          class="text-sm font-semibold text-brand-900"
        >
          Built around your needs
        </h2>
        <p class="text-sm leading-6 text-slate-600">
          A growing catalogue for everyday digital and support services.
        </p>
        <p class="text-sm leading-6 text-slate-600">
          Clear, human-reviewed payment and fulfilment steps.
        </p>
      </div>
    </section>

    <section
      class="mx-auto max-w-7xl px-5 py-14 sm:px-8"
      aria-labelledby="information-heading"
    >
      <div class="rounded-2xl bg-brand-900 p-7 text-white sm:p-10">
        <h2
          id="information-heading"
          class="text-2xl font-semibold tracking-tight"
        >
          Need help choosing a service?
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100">
          Read answers about manual payment and fulfilment, or review the
          business information currently available.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-11 items-center rounded-lg bg-white px-4 font-semibold text-brand-900 hover:bg-blue-50"
            href="/faq"
          >
            Read FAQs
          </a>
          <a
            class="inline-flex min-h-11 items-center rounded-lg border border-white/40 px-4 font-semibold text-white hover:bg-white/10"
            href="/contact"
          >
            Contact information
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
