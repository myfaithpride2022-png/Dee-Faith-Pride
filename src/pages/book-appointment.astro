---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import { site } from "@/data/site";
import { createWhatsAppLink } from "@/lib/whatsapp";
---

<BaseLayout
  title="Book an appointment | Dee-Faith Pride Multi-Biz"
  description="Appointment booking information for Dee-Faith Pride Multi-Biz."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Appointments"
      title="Plan your visit"
      description="We are open around the clock. Contact us first if your request needs preparation or a specific service provider."
    />
    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
      <div class="max-w-3xl rounded-2xl border border-slate-200 bg-white p-7 sm:p-10">
        <h2 class="text-lg font-semibold text-slate-900">Visit any time</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          {site.location}. {site.openingHours}. This page does not reserve
          appointment slots; a WhatsApp message is an enquiry only. The team
          will confirm availability and any service requirements with you.
        </p>
        <a
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-[#167a4a] px-5 text-sm font-semibold text-white hover:bg-[#12633c]"
          href={createWhatsAppLink(
            `Hello ${site.name}, I would like to ask about visiting for a service.`,
          )}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ask about a visit on WhatsApp
        </a>
        <a
          class="ml-3 inline-flex min-h-11 items-center font-semibold text-brand-800"
          href={site.mapsSearchUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Get directions
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
