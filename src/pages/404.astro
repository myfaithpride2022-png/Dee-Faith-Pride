---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Dee-Faith Pride Multi-Biz"
  description="The requested page could not be found."
>
  <main
    id="main-content"
    class="mx-auto max-w-7xl px-5 py-20 text-center sm:px-8"
  >
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-700">
      404
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-brand-900">
      We could not find that page
    </h1>
    <p class="mt-4 text-slate-600">
      The link may be incorrect, or the page may have moved.
    </p>
    <a
      class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-brand-800 px-5 font-semibold text-white hover:bg-brand-900"
      href="/"
    >
      Return home
    </a>
  </main>
</BaseLayout>
