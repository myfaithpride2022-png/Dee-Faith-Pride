---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
---

<BaseLayout
  title="Privacy notice (draft) | Dee-Faith Pride Multi-Biz"
  description="Draft privacy notice awaiting business-owner and legal review."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Draft · Owner approval required"
      title="Privacy notice"
      description="This draft is not an approved privacy policy and must be reviewed and completed by the business before publication or collection of customer information."
    />
    <section class="mx-auto max-w-4xl px-5 py-12 sm:px-8">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-7 text-amber-950">
        <p class="font-semibold">Not approved for production</p>
        <p class="mt-2">
          The business has not supplied its data controller details, contact
          channel, retention periods, complaint process, or final data-handling
          practices. This page is a publication placeholder, not legal advice.
          Do not submit personal, payment, account, or identity information
          through this development website.
        </p>
      </div>
      <h2 class="mt-8 text-xl font-semibold text-brand-900">
        Information and use
      </h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        Before any customer data is collected, the business must document what
        information is necessary for each service, why it is used, who can
        access it, how long it is retained, and how customers can exercise their
        rights. Credentials for third-party accounts must never be requested.
      </p>
      <h2 class="mt-7 text-xl font-semibold text-brand-900">
        Contact and retention
      </h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        Contact details and retention/deletion procedures have not been
        provided. This draft requires business-owner approval and appropriate
        legal review before it can be relied upon.
      </p>
    </section>
  </main>
</BaseLayout>
