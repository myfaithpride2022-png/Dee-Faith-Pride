---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
---

<BaseLayout
  title="Terms of service (draft) | Dee-Faith Pride Multi-Biz"
  description="Draft terms of service awaiting business-owner approval."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Draft · Owner approval required"
      title="Terms of service"
      description="This placeholder is not an approved contract or a statement of final business terms."
    />
    <section class="mx-auto max-w-4xl px-5 py-12 sm:px-8">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-7 text-amber-950">
        <p class="font-semibold">Requires business-owner and legal review</p>
        <p class="mt-2">
          The business has not supplied its approved terms, service
          responsibilities, complaint process, or applicable legal details. This
          page must be completed and approved before publication.
        </p>
      </div>
      <h2 class="mt-8 text-xl font-semibold text-brand-900">
        Requests and service delivery
      </h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        Service availability, price, requirements, and any expected timing must
        be confirmed with the business before a request is accepted. No service
        is represented as complete until an authorised business representative
        has actually fulfilled and recorded it.
      </p>
      <h2 class="mt-7 text-xl font-semibold text-brand-900">Manual payment</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        The planned payment model is manual. A customer-submitted receipt or
        reference is not proof of receipt and does not confirm payment. Only an
        administrator who verifies the funds may mark payment as confirmed.
      </p>
    </section>
  </main>
</BaseLayout>
