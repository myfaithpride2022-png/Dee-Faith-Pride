---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
---

<BaseLayout
  title="Promotions | Dee-Faith Pride Multi-Biz"
  description="View current promotions from Dee-Faith Pride Multi-Biz."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Offers"
      title="Promotions"
      description="Only active, approved promotions will appear here."
    />
    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-7 sm:p-10">
        <h2 class="text-lg font-semibold text-slate-900">
          No active promotions
        </h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
          There are no configured or approved campaigns to display at this time.
          No discounts or special prices are being advertised.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
