---
import { createWhatsAppLink } from "@/lib/whatsapp";

interface Props {
  service: {
    slug: string;
    name: string;
    description: string;
    category: string;
    categorySlug: string;
    priceLabel?: string;
    details?: string[];
  };
}

const { service } = Astro.props;
const prompts = service.details?.slice(0, 3) ?? [];
const enquiryMessage = [
  "Hello Dee-Faith Pride Multi-Biz,",
  "",
  `I would like to enquire/book: ${service.name}.`,
  "",
  "Please confirm availability, requirements, and the current price.",
  ...(prompts.length > 0
    ? ["", "I can provide:", ...prompts.map((prompt) => `- ${prompt}`)]
    : []),
].join("\n");
---

<article
  class="service-card flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md"
  data-category={service.categorySlug}
  data-search={`${service.name} ${service.category} ${service.description}`}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">
    {service.category}
  </p>
  <h3 class="mt-3 text-lg font-semibold tracking-tight text-slate-950">
    {service.name}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">
    {service.description}
  </p>
  <p class="mt-4 text-xs font-medium text-amber-800">
    {service.priceLabel ?? "Message us for current price and availability"}
  </p>
  {prompts.length > 0 && (
    <ul class="mt-3 space-y-1">
      {prompts.slice(0, 2).map((prompt) => (
        <li class="flex gap-2 text-xs leading-5 text-slate-500">
          <span class="text-brand-700" aria-hidden="true">
            ·
          </span>
          {prompt}
        </li>
      ))}
    </ul>
  )}
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    <a
      class="inline-flex min-h-10 items-center rounded-lg bg-brand-800 px-3 text-sm font-semibold text-white hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
      href={createWhatsAppLink(enquiryMessage)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Book or enquire about ${service.name} on WhatsApp`}
    >
      Book / enquire
    </a>
    <a
      class="inline-flex min-h-10 items-center text-sm font-semibold text-brand-800 hover:text-brand-700 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
      href={`/services/${service.slug}`}
      aria-label={`View details for ${service.name}`}
    >
      Details
    </a>
  </div>
</article>
