---
import { site } from "@/data/site";

const links = [
  { href: "/services", label: "Services" },
  { href: "/promotions", label: "Promotions" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header class="border-b border-slate-200/80 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-8">
    <a
      class="flex min-w-0 items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700"
      href="/"
      aria-label={`${site.name} home`}
    >
      <span
        class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-900 text-sm font-bold text-white"
        aria-hidden="true"
      >
        DF
      </span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-bold tracking-tight text-slate-950 sm:text-base">
          {site.name}
        </span>
        <span class="hidden text-xs text-slate-600 sm:block">
          {site.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {links.map((link) => (
        <a
          class="text-sm font-medium text-slate-700 transition-colors hover:text-brand-800 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-brand-800 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
      href="/services"
    >
      Browse services
    </a>
  </div>

  <nav
    class="flex gap-6 overflow-x-auto border-t border-slate-100 px-5 py-3 md:hidden"
    aria-label="Mobile navigation"
  >
    {links.map((link) => (
      <a
        class="shrink-0 text-sm font-medium text-slate-700 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700"
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
