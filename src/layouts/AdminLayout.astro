---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { StaffProfile } from "@/lib/supabase/auth";

interface Props {
  title: string;
  profile: StaffProfile;
}

const { title, profile } = Astro.props;
---

<BaseLayout title={`${title} | Dee-Faith Pride Admin`}>
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
      <div>
        <a class="font-bold text-brand-900" href="/admin">
          Dee-Faith Pride <span class="font-medium text-slate-500">Admin</span>
        </a>
        <p class="mt-1 text-xs text-slate-600">
          Signed in as {profile.display_name} · {profile.role}
        </p>
      </div>
      <button
        class="min-h-10 rounded-lg border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:border-brand-700 hover:text-brand-800"
        type="button"
        data-admin-logout
      >
        Sign out
      </button>
      <p
        class="basis-full text-sm text-rose-700"
        data-logout-status
        role="status"
        aria-live="polite"
      ></p>
    </div>
    <nav
      class="mx-auto flex max-w-7xl gap-5 overflow-x-auto px-5 pb-4 sm:px-8"
      aria-label="Admin navigation"
    >
      <a class="shrink-0 text-sm font-medium text-brand-800" href="/admin">
        Overview
      </a>
      <a
        class="shrink-0 text-sm font-medium text-brand-800"
        href="/admin/services"
      >
        Services
      </a>
      <a
        class="shrink-0 text-sm font-medium text-brand-800"
        href="/admin/orders"
      >
        Orders & payments
      </a>
    </nav>
  </header>
  <slot />
</BaseLayout>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-admin-logout]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector<HTMLElement>(
        "[data-logout-status]",
      );
      button.disabled = true;
      try {
        const response = await fetch("/api/admin/logout", { method: "POST" });
        if (!response.ok) throw new Error("Sign-out failed.");
        window.location.assign("/admin/login");
      } catch {
        button.disabled = false;
        if (status)
          status.textContent = "Unable to sign out. Please try again.";
      }
    });
</script>
